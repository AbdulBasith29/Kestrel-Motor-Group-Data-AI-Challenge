 name='[usr:w4_h2:qk]' pivot='key' type='quantitative' /><column-instance column='[w4_h1]' derivation='User' name='[usr:w4_h1:qk]' pivot='key' type='quantitative' /><column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' /><column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.feedback_monthly].[none:state:nk]' filter-group='2'><groupfilter function='level-members' level='[none:state:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><filter class='categorical' column='[federated.feedback_monthly].[none:department:nk]' filter-group='3'><groupfilter function='level-members' level='[none:department:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><slices><column>[federated.feedback_monthly].[none:state:nk]</column><column>[federated.feedback_monthly].[none:department:nk]</column></slices><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.feedback_monthly].[usr:w4_h2:qk]' /><text column='[federated.feedback_monthly].[usr:w4_h1:qk]' /></encodings><customized-label><formatted-text><run fontsize='10' bold='true' fontcolor='#333333'>Worsening four, Apr-Sep</run><run>Æ&#10;</run><run fontsize='18' bold='true' fontcolor='#eb6834'>&lt;[federated.feedback_monthly].[usr:w4_h2:qk]&gt;</run><run>Æ&#10;</run><run fontsize='10' fontcolor='#555555'>negative, from </run><run fontsize='10' fontcolor='#555555'>&lt;[federated.feedback_monthly].[usr:w4_h1:qk]&gt;</run><run fontsize='10' fontcolor='#555555'> in H1</run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid='{