    <worksheet name='Themes at worsening sites'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Themes in negative comments at the four worsening sites</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='theme_drivers' name='federated.theme_drivers' />
          </datasources>
          <datasource-dependencies datasource='federated.theme_drivers'>
            <column caption='Half Year' datatype='string' name='[half_year]' role='dimension' type='nominal' />
            <column caption='Negative Responses With Ai' datatype='integer' name='[negative_responses_with_ai]' role='measure' type='quantitative' />
            <column caption='Negative Theme Mentions' datatype='integer' name='[negative_theme_mentions]' role='measure' type='quantitative' />
            <column-instance column='[half_year]' derivation='None' name='[none:half_year:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_group]' derivation='None' name='[none:site_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[theme_name]' derivation='None' name='[none:theme_name:nk]' pivot='key' type='nominal' />
            <column caption='Site Group' datatype='string' name='[site_group]' role='dimension' type='nominal' />
            <column caption='Theme Name' datatype='string' name='[theme_name]' role='dimension' type='nominal' />
            <column caption='Share of negative responses' datatype='real' default-format='p0%' name='[theme_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([negative_theme_mentions]) / SUM([negative_responses_with_ai])' />
            </column>
            <column-instance column='[theme_share]' derivation='User' name='[usr:theme_share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.theme_drivers].[none:site_group:nk]'>
            <groupfilter function='member' level='[none:site_group:nk]' member='&quot;Worsening four&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.theme_drivers].[none:theme_name:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Waiting/booking&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Communication&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Repair quality&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Price/value&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Parts availability&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Staff service&quot;' />
              <groupfilter function='member' level='[none:theme_name:nk]' member='&quot;Sales process&quot;' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.theme_drivers].[none:theme_name:nk]' direction='DESC' using='[federated.theme_drivers].[usr:theme_share:qk]' />
          <slices>
            <column>[federated.theme_drivers].[none:site_group:nk]</column>
            <column>[federated.theme_drivers].[none:theme_name:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.theme_drivers].[none:half_year:nk]' type='palette'>
              <map to='#86b6ef'>
                <bucket>&quot;H1 (Oct-Mar)&quot;</bucket>
              </map>
              <map to='#eb6834'>
                <bucket>&quot;H2 (Apr-Sep)&quot;</bucket>
