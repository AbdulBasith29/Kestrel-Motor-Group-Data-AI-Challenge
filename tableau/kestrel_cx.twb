            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.theme_drivers].[none:theme_name:nk] / [federated.theme_drivers].[none:half_year:nk])</rows>
        <cols>[federated.theme_drivers].[usr:theme_share:qk]</cols>
