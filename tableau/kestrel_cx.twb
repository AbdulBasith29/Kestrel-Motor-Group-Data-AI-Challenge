          <datasource-dependencies datasource='federated.data_quality'>
            <column caption='AI coverage of comments' datatype='real' default-format='p0.0%' name='[ai_coverage]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([enriched_responses]) / SUM([commented_responses])' />
            </column>
            <column caption='Commented Responses' datatype='real' name='[commented_responses]' role='measure' type='quantitative' />
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Enriched Responses' datatype='real' name='[enriched_responses]' role='measure' type='quantitative' />
            <column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' />
            <column-instance column='[ai_coverage]' derivation='User' name='[usr:ai_coverage:qk]' pivot='key' type='quantitative' />
