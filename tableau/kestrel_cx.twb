    <worksheet name='Department'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Negative share by department (rated responses scoring 1-2)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='feedback_monthly' name='federated.feedback_monthly' />
          </datasources>
          <datasource-dependencies datasource='federated.feedback_monthly'>
            <column caption='Department' datatype='string' name='[department]' role='dimension' type='nominal' />
            <column caption='Negative share' datatype='real' default-format='p0.0%' name='[neg_share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([negative_responses]) / SUM([rated_responses])' />
            </column>
            <column caption='Negative Responses' datatype='integer' name='[negative_responses]' role='measure' type='quantitative' />
