easure' type='quantitative' /><column caption="State" datatype='string' name='[state]' role='dimension' type='nominal' /><column caption="Service share of negatives" datatype='real' default-format='p0%' name='[service_share]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [department] = 'Service' THEN [negative_responses] END) / SUM([negative_responses])" /></column><column-instance column='[service_share]' derivation='User' name='[usr:service_share:qk]' pivot='key' type='quantitative' /><column-instance column='[rated_responses]' derivation='Sum' name='[sum:rated_responses:qk]' pivot='key' type='quantitative' /><column-instance column='[negative_responses]' derivation='Sum' name='[sum:negative_responses:qk]' pivot='key' type='quantitative' /><column-instance column='[state]' derivation='None' name='[none:state:nk]' pivot='key' type='nominal' /><column-instance column='[department]' derivation='None' name='[none:department:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.feedback_monthly].[none:state:nk]' filter-group='2'><groupfilter function='level-members' level='[none:state:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><filter class='categorical' column='[federated.feedback_monthly].[none:department:nk]' filter-group='3'><groupfilter function='level-members' level='[none:department:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter><slices><column>[federated.feedback_monthly].[none:state:nk]</column><column>[federated.feedback_monthly].[none:department:nk]</column></slices><aggregation value='true' /></view><style /><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.feedback_monthly].[usr:service_share:qk]' /><tooltip column='[federated.feedback_monthly].[sum:rated_responses:qk]' /><tooltip column='[federated.feedback_m